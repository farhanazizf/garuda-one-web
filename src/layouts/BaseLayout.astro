---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { club, clubMapsLinkProps, registrationLink, trainingLocationLine } from '../data/club';
import type { Locale, PageSlug } from '../i18n/locales';
import { getMessages } from '../i18n/messages';
import { localeCanonicalPath, localePagePath } from '../i18n/paths';
import { absoluteSiteUrl, withBase } from '../utils/paths';

interface Props {
  locale: Locale;
  page: PageSlug;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const messages = getMessages(locale);
const L = messages.layout;
const regLink = registrationLink(locale);
const ogLocale = locale === 'en' ? 'en_US' : 'id_ID';
const altLocale: Locale = locale === 'id' ? 'en' : 'id';
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonicalPath = localeCanonicalPath(locale, page);
const canonical = absoluteSiteUrl(siteUrl, canonicalPath);
const altCanonical = siteUrl ? absoluteSiteUrl(siteUrl, localeCanonicalPath(altLocale, page)) : null;
const logoAbsolute = siteUrl ? `${siteUrl}/garuda-one-logo.jpg` : club.logo;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: club.name,
  description: L.schemaDescription,
  telephone: '+62 821-1517-2019',
  areaServed: 'Tangerang Selatan',
  sport: 'Basketball',
  location: {
    '@type': 'Place',
    name: club.venueName,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bintaro',
      addressRegion: 'Tangerang Selatan',
      addressCountry: 'ID',
    },
    hasMap: club.mapsUrl,
  },
  sameAs: [club.instagram],
  ...(siteUrl ? { '@id': `${siteUrl}/#club`, url: siteUrl, logo: logoAbsolute } : {}),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Teko:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap.xml')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      altCanonical && (
        <>
          <link rel="alternate" hreflang={locale} href={canonical} />
          <link rel="alternate" hreflang={altLocale} href={altCanonical} />
          <link
            rel="alternate"
            hreflang="x-default"
            href={absoluteSiteUrl(siteUrl, localeCanonicalPath('id', page))}
          />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {logoAbsolute && <meta property="og:image" content={logoAbsolute} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#konten">{L.skipToContent}</a>
    <header class="site-header">
      <a class="brand" href={localePagePath(locale, 'home')} aria-label={L.brandAriaLabel}>
        <img src={club.logo} alt="" width="56" height="56" />
        <span><span class="brand-accent">GARUDAONE</span><small>BASKETBALL</small></span>
      </a>
      <nav aria-label={L.navAriaLabel}>
        <a
          class:list={['nav-link', page === 'home' && 'nav-link--current']}
          href={localePagePath(locale, 'home')}
          aria-current={page === 'home' ? 'page' : undefined}
        >
          {L.navHome}
        </a>
        <a
          class:list={['nav-link', page === 'about' && 'nav-link--current']}
          href={localePagePath(locale, 'about')}
          aria-current={page === 'about' ? 'page' : undefined}
        >
          {L.navAbout}
        </a>
        <a
          class:list={['nav-link', page === 'partnership' && 'nav-link--current']}
          href={localePagePath(locale, 'partnership')}
          aria-current={page === 'partnership' ? 'page' : undefined}
        >
          {L.navPartnership}
        </a>
        <a class="nav-link nav-location" {...clubMapsLinkProps}
          >{L.navLocation} {messages.shared.mapsLinkSuffix}</a
        >
      </nav>
      <a class="header-cta" href={regLink} target="_blank" rel="noopener noreferrer">
        {L.headerCta} <span aria-hidden="true">{messages.shared.mapsLinkSuffix}</span>
      </a>
    </header>
    <main id="konten" class="page-shell"><slot /></main>
    <footer class="site-footer">
      <div>
        <p class="footer-name">GARUDAONE<br />BASKETBALL</p>
        <p>{club.tagline} · {club.location}</p>
        <p class="footer-venue">
          {L.footerTraining}{' '}
          <a {...clubMapsLinkProps}>{trainingLocationLine} {messages.shared.mapsLinkSuffix}</a>
        </p>
      </div>
      <div class="footer-links">
        <a {...clubMapsLinkProps}>{L.footerMaps} {messages.shared.mapsLinkSuffix}</a>
        <a href={club.instagram} target="_blank" rel="noopener noreferrer"
          >{L.footerInstagram} {messages.shared.mapsLinkSuffix}</a
        >
        <a href={regLink} target="_blank" rel="noopener noreferrer"
          >{L.footerWhatsapp} {messages.shared.mapsLinkSuffix}</a
        >
      </div>
      <div class="footer-lang">
        <LanguageSwitcher locale={locale} page={page} />
      </div>
      <p class="footer-note">{L.footerNote}</p>
    </footer>
  </body>
</html>

<style>
  .footer-lang {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    padding-top: 0.25rem;
  }

  :global(.site-header nav .nav-link) {
    position: relative;
    opacity: 0.65;
    color: #d8d4cc;
    padding-bottom: 0.2rem;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  :global(.site-header nav .nav-link:hover) {
    opacity: 1;
    color: #f3f0e8;
  }

  :global(.site-header nav .nav-link--current) {
    opacity: 1;
    color: #dbad5f;
  }

  :global(.site-header nav .nav-link--current::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    background: #dbad5f;
    border-radius: 1px;
  }

  :global(.site-header nav .nav-location) {
    opacity: 0.82;
    color: #c7b18f;
  }

  :global(.site-header nav .nav-location:hover) {
    color: #e8b864;
  }
</style>
