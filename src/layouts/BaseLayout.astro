---
import '../styles/global.css';
import { club, clubMapsLinkProps, registrationLink, trainingLocationLine } from '../data/club';
import { absoluteSiteUrl, withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonical = absoluteSiteUrl(siteUrl, path);
const logoAbsolute = siteUrl ? `${siteUrl}/garuda-one-logo.jpg` : club.logo;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: club.name,
  description: 'Klub basket usia muda di Bintaro, Tangerang Selatan.',
  telephone: '+62 821-1517-2019',
  areaServed: 'Tangerang Selatan',
  sport: 'Basketball',
  location: {
    '@type': 'Place',
    name: club.venueName,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bintaro',
      addressRegion: 'Tangerang Selatan',
      addressCountry: 'ID',
    },
    hasMap: club.mapsUrl,
  },
  sameAs: [club.instagram],
  ...(siteUrl ? { url: siteUrl, logo: logoAbsolute } : {}),
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {logoAbsolute && <meta property="og:image" content={logoAbsolute} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <header class="site-header">
      <a class="brand" href={withBase("")} aria-label="Garudaone Basketball, beranda">
        <img src={club.logo} alt="" width="56" height="56" />
        <span><span class="brand-accent">GARUDAONE</span><small>BASKETBALL</small></span>
      </a>
      <nav aria-label="Navigasi utama">
        <a href={withBase("")}>Beranda</a>
        <a href={withBase("tentang/")}>Tentang klub</a>
        <a href={withBase("kolaborasi/")}>Kolaborasi</a>
        <a class="nav-location" {...clubMapsLinkProps}>Lokasi ↗</a>
      </nav>
      <a class="header-cta" href={registrationLink} target="_blank" rel="noopener noreferrer">Tanya pendaftaran <span aria-hidden="true">↗</span></a>
    </header>
    <main id="konten" class="page-shell"><slot /></main>
    <footer class="site-footer">
      <div>
        <p class="footer-name">GARUDAONE<br />BASKETBALL</p>
        <p>{club.tagline} · {club.location}</p>
        <p class="footer-venue">
          Latihan: <a {...clubMapsLinkProps}>{trainingLocationLine} ↗</a>
        </p>
      </div>
      <div class="footer-links">
        <a {...clubMapsLinkProps}>Google Maps ↗</a>
        <a href={club.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a href={registrationLink} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
      </div>
      <p class="footer-note">Jadwal tiap kelompok dan biaya — konfirmasi lewat WhatsApp admin.</p>
    </footer>
  </body>
</html>
