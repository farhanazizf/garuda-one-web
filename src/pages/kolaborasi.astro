---
import BaseLayout from '../layouts/BaseLayout.astro';
import { club, partnershipLink } from '../data/club';
---

<BaseLayout
  title="Kolaborasi & Partnership | Garudaone Basketball"
  description="Kolaborasi dan partnership dengan Garudaone Basketball — klub basket usia muda di Bintaro."
  path="/kolaborasi/"
>
  <section class="page-hero sponsor-hero">
    <p class="eyebrow"><span class="eyebrow-line"></span> KOLABORASI & PARTNERSHIP</p>
    <h1>Bareng bangun<br /><em>generasi muda.</em></h1>
    <p>
      {club.name} terbuka untuk kolaborasi brand, venue, event, dan dukungan komunitas — latihan, turnamen, dan
      kegiatan pemain.
    </p>
  </section>
  <section class="sponsor-body section-pad">
    <div>
      <span class="section-number">MENGENAL KLUB</span>
      <h2>Di lapangan<br />dan di luar lapangan.</h2>
    </div>
    <div>
      <p>
        Klub di {club.location}, pemain usia {club.ages}. Aktivitas kami aktif di Instagram — prestasi, latihan, dan
        komunitas orang tua.
      </p>
      <p>
        Bentuk partnership (sponsorship, co-branding, dukungan event, dll.) kami bahas langsung lewat WhatsApp — belum
        ada paket fixed di website.
      </p>
      <div class="sponsor-actions">
        <a class="button button-dark" href={partnershipLink} target="_blank" rel="noopener noreferrer">
          Chat tentang kolaborasi ↗
        </a>
        <a class="inline-link" href={club.instagram} target="_blank" rel="noopener noreferrer">
          Lihat aktivitas klub ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
