---
import BaseLayout from '../layouts/BaseLayout.astro';
import MotionDirector from '../components/MotionDirector.jsx';
import ClubAchievements from '../components/ClubAchievements.astro';
import ClubMoments from '../components/ClubMoments.astro';
import InstagramActivity from '../components/InstagramActivity.astro';
import { club, clubMapsLinkProps, registrationLink } from '../data/club';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Garudaone Basketball | Klub Basket Usia Muda di Bintaro"
  description="Garudaone Basketball — klub basket anak di Bintaro. Info latihan dan pendaftaran lewat WhatsApp."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> KLUB BASKET USIA MUDA · BINTARO</p>
      <h1 id="hero-title" class="max-w-6xl">Tumbuh bersama.<br /><em>Terbang tinggi.</em></h1>
      <p class="hero-intro">Di lapangan anak belajar teknik, berani coba, dan latihan bareng tim.</p>
      <div class="hero-actions">
        <a class="button button-gold" href={registrationLink} target="_blank" rel="noopener noreferrer">Tanya pendaftaran <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase("tentang/")}>Kenali klub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-mark" aria-label="Logo Garudaone Basketball">
      <img src={club.logo} alt="Logo Garudaone Basketball: elang dengan sayap terbuka" width="512" height="512" fetchpriority="high" />
      <span class="hero-mark-caption">TOGETHER<br />WE FLY.</span>
    </div>
    <div class="hero-bottom"><span>GARUDAONE BASKETBALL</span><span>BINTARO — TANGERANG SELATAN</span></div>
  </section>

  <div class="club-marquee" aria-hidden="true"><div class="club-marquee-track"><span>GARUDAONE BASKETBALL</span><span>TOGETHER WE FLY</span><span>BINTARO · TANGERANG SELATAN</span><span>GARUDAONE BASKETBALL</span><span>TOGETHER WE FLY</span><span>BINTARO · TANGERANG SELATAN</span></div></div>

  <section class="intro-section section-pad" aria-labelledby="intro-title">
    <div class="section-heading"><span class="section-number">KLUB KAMI</span><h2 id="intro-title">Satu tim.<br />Satu arah.</h2></div>
    <div class="intro-content">
      <p>{club.name} di Bintaro, Tangerang Selatan. Latihan rutin, ikut turnamen, dan tumbuh bareng.</p>
      <p class="intro-source">Kelompok usia <strong>{club.ages}</strong> (sesuai info Instagram kami). Latihan di <a {...clubMapsLinkProps}>{club.venueName}</a>, Bintaro. Untuk jadwal kelas dan slot, chat admin ya.</p>
      <a class="inline-link" href={withBase("tentang/")}>Lihat profil klub <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <ClubAchievements />
  <ClubMoments />

  <section class="path-section section-pad" aria-labelledby="path-title">
    <div class="section-topline"><span class="section-number">CARA BERGABUNG</span><span>UNTUK ORANG TUA</span></div>
    <h2 id="path-title">Mulai dari<br /><em>chat WhatsApp.</em></h2>
    <div class="path-grid">
      <article class="path-item"><span>01</span><h3>Ceritakan usia anak</h3><p>Admin bantu carikan kelompok usia yang pas.</p></article>
      <article class="path-item"><span>02</span><h3>Tanyakan detail latihan</h3><p>Tanya jadwal, biaya, dan cara daftar lewat WhatsApp.</p></article>
      <article class="path-item"><span>03</span><h3>Kenali suasananya</h3><p>Scroll Instagram kami buat lihat suasana latihan.</p></article>
    </div>
    <a class="button button-dark" href={registrationLink} target="_blank" rel="noopener noreferrer">Chat admin di WhatsApp <span aria-hidden="true">↗</span></a>
  </section>

  <section class="faq-section section-pad" aria-labelledby="faq-title">
    <div><p class="section-number">PERTANYAAN ORANG TUA</p><h2 id="faq-title">Yang perlu diketahui<br />sebelum bergabung.</h2></div>
    <div class="faq-list">
      <details open><summary>Usia berapa yang bisa bergabung?<span class="faq-preview">Usia 5–10 & 12–18 tahun.</span></summary><p>Di Instagram kami kelompok usia 5–10 dan 12–18 tahun. Chat admin untuk kelas yang masih buka.</p></details>
      <details><summary>Di mana lokasi latihannya?<span class="faq-preview">{club.venueName}, Bintaro.</span></summary><p>Latihan di <strong>{club.venueName}</strong>, Bintaro, Tangerang Selatan. <a {...clubMapsLinkProps}>Buka lokasi di Google Maps ↗</a>. Jadwal tiap kelompok beda — admin jelaskan lewat WhatsApp.</p></details>
      <details><summary>Bagaimana cara bertanya atau mendaftar?<span class="faq-preview">Lewat WhatsApp resmi klub.</span></summary><p>Pakai tombol di halaman ini — langsung ke WhatsApp admin. Tanya jadwal, biaya, atau cara daftar.</p></details>
    </div>
  </section>

  <InstagramActivity />

  <section class="sponsor-teaser section-pad" aria-labelledby="partnership-title">
    <div><p class="section-number">KOLABORASI</p><h2 id="partnership-title">Partnership<br /><em>bareng klub.</em></h2></div>
    <div><p>Brand, venue, event, atau dukungan komunitas — kita bahas bentuk kolaborasinya lewat WhatsApp.</p><a class="button button-outline" href={withBase("kolaborasi/")}>Info kolaborasi <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="contact-band section-pad home-contact" aria-labelledby="contact-title">
    <span class="section-number">MULAI BERSAMA</span>
    <h2 id="contact-title">Tanya dulu,<br /><em>baru putuskan.</em></h2>
    <a class="button button-gold" href={registrationLink} target="_blank" rel="noopener noreferrer">Chat admin lewat WhatsApp <span aria-hidden="true">↗</span></a>
  </section>
  <MotionDirector client:load />
</BaseLayout>
