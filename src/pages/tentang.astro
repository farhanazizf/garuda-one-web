---
import BaseLayout from '../layouts/BaseLayout.astro';
import { club, registrationLink } from '../data/club';
---

<BaseLayout title="Tentang Klub | Garuda One Basketball" description="Profil Garuda One Basketball, klub basket usia muda di Bintaro, Tangerang Selatan. Kenali kelompok usia dan hubungi admin untuk informasi latihan." path="/tentang/">
  <section class="page-hero">
    <p class="eyebrow"><span class="eyebrow-line"></span> PROFIL KLUB</p>
    <h1>Bergerak<br /><em>sebagai satu.</em></h1>
    <p>Garuda One Basketball hadir untuk pemain usia muda di Bintaro, Tangerang Selatan. Semangat yang dibawa klub sederhana: <strong>{club.tagline}</strong>.</p>
  </section>
  <section class="facts-section section-pad">
    <div class="section-topline"><span class="section-number">FAKTA KLUB</span><span>BERDASARKAN KANAL RESMI</span></div>
    <div class="facts-grid">
      <div><span>01</span><h2>Lokasi</h2><p>{club.location}</p></div>
      <div><span>02</span><h2>Kelompok usia</h2><p>{club.ages}</p></div>
      <div><span>03</span><h2>Aktivitas</h2><p>Latihan, pertandingan, dan kegiatan komunitas basket.</p></div>
    </div>
    <p class="source-note">Jadwal, tempat latihan, biaya, dan ketersediaan kelas dapat berubah. Admin klub memberikan informasi terbaru melalui WhatsApp.</p>
  </section>
  <section class="contact-band section-pad"><span class="section-number">INGIN BERGABUNG?</span><h2>Kenali kelompok latihan<br />yang tepat untuk anak Anda.</h2><a class="button button-gold" href={registrationLink} target="_blank" rel="noopener noreferrer">Tanya admin lewat WhatsApp ↗</a></section>
</BaseLayout>
