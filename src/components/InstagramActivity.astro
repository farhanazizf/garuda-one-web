---
import { club } from '../data/club';
import { instagramBlockEmbed, instagramBlockFacts } from '../data/club-media';
import { withBase } from '../utils/paths';

const facts = instagramBlockFacts();
const embed = instagramBlockEmbed();
const showGblPoster = Boolean(embed?.localReady && embed.localPath);
---

<section class="instagram-section section-pad" aria-labelledby="instagram-title">
  <div class="instagram-copy">
    <div class="section-topline">
      <span class="section-number">INSTAGRAM</span>
      <a href={club.instagram} target="_blank" rel="noopener noreferrer">@garudaonebasketball ↗</a>
    </div>
    <h2 id="instagram-title">Kabar<br /><em>terbaru.</em></h2>
    <p class="instagram-intro">Ringkasan dari postingan @garudaonebasketball — liga, tim, dan hasil pertandingan.</p>

    {
      facts.map((item, index) => (
        <article class="instagram-fact">
          <span class="instagram-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            {item.kicker ? <p class="instagram-kicker">{item.kicker.toUpperCase()}</p> : null}
            <h3>{item.title}</h3>
            {item.caption && item.id === 'ku14-black-yellow' ? (
              <p class="instagram-quote">“{item.caption}”</p>
            ) : null}
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.id === 'ku14-black-yellow' ? 'Lihat postingan tim' : 'Lihat pengumuman GBL'}{' '}
                <span aria-hidden="true">↗</span>
              </a>
            ) : null}
          </div>
        </article>
      ))
    }

  </div>

  {
    embed ? (
      <div class="instagram-media" aria-label="Garudaone Basketball League 2026">
        {
          showGblPoster ? (
            <figure class="instagram-gbl-poster-wrap">
              <a href={embed.href} target="_blank" rel="noopener noreferrer">
                <img
                  class="instagram-gbl-poster"
                  src={withBase(embed.localPath!.replace(/^\//, ''))}
                  alt={embed.alt ?? embed.title}
                  width="1600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                Poster resmi GBL 2026.{' '}
                {embed.href ? (
                  <a href={embed.href} target="_blank" rel="noopener noreferrer">
                    Buka carousel di Instagram ↗
                  </a>
                ) : null}
              </figcaption>
            </figure>
          ) : (
            <>
              <iframe
                src={embed.embedUrl}
                title="Pengumuman Garudaone Basketball League 2026 dari Instagram resmi Garudaone Basketball"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allowtransparency="true"
                allowfullscreen
              />
              {embed.href ? (
                <p>
                  Jika postingan tidak tampil,{' '}
                  <a href={embed.href} target="_blank" rel="noopener noreferrer">
                    buka langsung di Instagram ↗
                  </a>
                  .
                </p>
              ) : null}
            </>
          )
        }
      </div>
    ) : null
  }
</section>

<style>
  .instagram-gbl-poster-wrap {
    margin: 0;
  }

  .instagram-gbl-poster {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
    background: #0c0c0b;
  }

  .instagram-gbl-poster-wrap figcaption {
    margin: 0.75rem 0.25rem 0;
    color: #68645d;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .instagram-gbl-poster-wrap figcaption a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.instagram-media:has(.instagram-gbl-poster)) {
    padding: 0.75rem;
  }

  :global(.instagram-media:has(.instagram-gbl-poster) iframe) {
    display: none;
  }
</style>
