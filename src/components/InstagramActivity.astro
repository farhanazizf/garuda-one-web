---
import { club } from '../data/club';
import { instagramBlockEmbed, instagramBlockFacts } from '../data/club-media';
import type { Locale } from '../i18n/locales';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { getMessages } from '../i18n/messages';
import { withBase } from '../utils/paths';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ig = getMessages(locale).instagram;
const shared = getMessages(locale).shared;

const facts = instagramBlockFacts();
const embed = instagramBlockEmbed();
const showGblPoster = Boolean(embed?.localReady && embed.localPath);
---

<section class="instagram-section section-pad" aria-labelledby="instagram-title">
  <div class="instagram-copy">
    <div class="section-topline">
      <span class="section-number">{ig.label}</span>
      <a href={club.instagram} target="_blank" rel="noopener noreferrer"
        >{ig.handleLink} {shared.mapsLinkSuffix}</a
      >
    </div>
    <h2 id="instagram-title">{ig.title.before}<br /><em>{ig.title.emphasis}</em></h2>
    <p class="instagram-intro">{ig.intro}</p>

    {
      facts.map((item, index) => (
        <article class="instagram-fact">
          <span class="instagram-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            {item.kicker ? <p class="instagram-kicker">{item.kicker.toUpperCase()}</p> : null}
            <h3>{item.title}</h3>
            {item.caption && item.id === 'ku14-black-yellow' ? (
              <p class="instagram-quote">“{item.caption}”</p>
            ) : null}
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.id === 'ku14-black-yellow' ? ig.linkTeamPost : ig.linkGblAnnouncement}{' '}
                <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
              </a>
            ) : null}
          </div>
        </article>
      ))
    }

  </div>

  {
    embed ? (
      <div class="instagram-media" aria-label={ig.gblMediaAria}>
        {
          showGblPoster ? (
            <figure class="instagram-gbl-poster-wrap">
              <a href={embed.href} target="_blank" rel="noopener noreferrer">
                <img
                  class="instagram-gbl-poster"
                  src={withBase(embed.localPath!.replace(/^\//, ''))}
                  alt={embed.alt ?? embed.title}
                  width="1600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                {ig.gblPosterCaption}{' '}
                {embed.href ? (
                  <a href={embed.href} target="_blank" rel="noopener noreferrer">
                    {ig.gblOpenCarousel} {shared.mapsLinkSuffix}
                  </a>
                ) : null}
              </figcaption>
            </figure>
          ) : (
            <>
              <iframe
                src={embed.embedUrl}
                title={ig.embedTitle}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allowtransparency="true"
                allowfullscreen
              />
              {embed.href ? (
                <p>
                  {ig.embedFallbackBefore}{' '}
                  <a href={embed.href} target="_blank" rel="noopener noreferrer">
                    {ig.embedFallbackLink} {shared.mapsLinkSuffix}
                  </a>
                  {ig.embedFallbackAfter}
                </p>
              ) : null}
            </>
          )
        }
      </div>
    ) : null
  }
</section>

<style>
  .instagram-gbl-poster-wrap {
    margin: 0;
  }

  .instagram-gbl-poster {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
    background: #0c0c0b;
  }

  .instagram-gbl-poster-wrap figcaption {
    margin: 0.75rem 0.25rem 0;
    color: #68645d;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .instagram-gbl-poster-wrap figcaption a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.instagram-media:has(.instagram-gbl-poster)) {
    padding: 0.75rem;
  }

  :global(.instagram-media:has(.instagram-gbl-poster) iframe) {
    display: none;
  }
</style>
