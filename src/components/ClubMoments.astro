---
import { club, clubMapsLinkProps } from '../data/club';
import {
  homeMomentsMedia,
  instagramThumbDimensions,
  instagramThumbFit,
  momentsGridMedia,
} from '../data/club-media';
import type { Locale } from '../i18n/locales';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { getMessages } from '../i18n/messages';
import { localePagePath } from '../i18n/paths';
import { withBase } from '../utils/paths';

interface Props {
  locale?: Locale;
  /** `highlight` = max 6 di homepage; `archive` = daftar lengkap */
  variant?: 'highlight' | 'archive';
}

const { locale = DEFAULT_LOCALE, variant = 'highlight' } = Astro.props;
const t = getMessages(locale).moments;
const shared = getMessages(locale).shared;

function fmt(template: string, vars: Record<string, string | number>) {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? `{${key}}`));
}

const isArchive = variant === 'archive';
const all = momentsGridMedia();
const items = isArchive ? all : homeMomentsMedia();
const total = all.length;
---

<section
  class:list={['moments-section', 'section-pad', isArchive && 'moments-section--archive']}
  aria-labelledby={isArchive ? 'activity-archive-title' : 'moments-title'}
  id={isArchive ? 'aktivitas-klub' : undefined}
>
  <div class="moments-heading">
    <span class="section-number">{isArchive ? t.labelArchive : t.labelHighlight}</span>
    {
      isArchive ? (
        <h2 id="activity-archive-title">
          {t.archiveTitle.before}<br /><em>{t.archiveTitle.emphasis}</em>
        </h2>
      ) : (
        <h2 id="moments-title">
          {t.highlightTitle.before}<br /><em>{t.highlightTitle.emphasis}</em>
        </h2>
      )
    }
    {
      isArchive ? (
        <>
          <p class="moments-intro">{fmt(t.archiveIntro, { total })}</p>
          {t.igNote ? <p class="moments-ig-note">{t.igNote}</p> : null}
        </>
      ) : (
        <p class="moments-intro">{t.highlightIntro}</p>
      )
    }
    <p class="moments-venue">
      {t.venuePrefix}{' '}
      <a {...clubMapsLinkProps}>{club.venueName} {shared.mapsLinkSuffix}</a>
    </p>
    {
      !isArchive && total > items.length ? (
        <a class="moments-more inline-link" href={`${localePagePath(locale, 'about')}#aktivitas-klub`}>
          {t.moreLink} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
        </a>
      ) : null
    }
  </div>
  <div class="moments-grid">
    {
      items.map((item, index) => {
        const thumb = instagramThumbDimensions(item);
        const fit = instagramThumbFit(item);
        const isReel = item.href?.includes('/reel/');
        return (
          <article class="moment-card">
            <span class="moment-index">{String(index + 1).padStart(2, '0')}</span>
            <div class="moment-media-slot">
              {item.localReady && item.localPath ? (
                <a
                  class="moment-media"
                  data-ig-frame={isReel ? 'reel' : 'post'}
                  style={`--ig-fit: ${fit}`}
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src={withBase(item.localPath.replace(/^\//, ''))}
                    alt={item.alt ?? item.title}
                    width={thumb.width}
                    height={thumb.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <div class="moment-media" aria-hidden="true" />
              )}
            </div>
            <div class="moment-body">
              {item.kicker ? <p class="moment-kicker">{item.kicker}</p> : null}
              <h3>{item.title}</h3>
              {item.caption ? <p class="moment-caption">{item.caption}</p> : null}
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  {shared.openPost} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
                </a>
              ) : null}
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .moments-more {
    display: inline-block;
    margin-top: 0.5rem;
  }

  .moments-ig-note {
    max-width: 520px;
    color: #68645d;
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0.5rem 0 0;
  }

  .moments-section .moments-grid {
    align-items: stretch;
  }

  .moment-card {
    height: 100%;
  }

  /* Satu tinggi slot media per baris — judul kartu sejajar meski campur reel + foto */
  .moment-media-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    flex-shrink: 0;
    margin-bottom: 0.35rem;
    background: #ddd6c8;
  }

  .moment-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 0;
  }

  .moment-card .moment-media {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border: 1px solid #c9c0b2;
  }

  .moment-card .moment-media[data-ig-frame='post'] img {
    object-fit: contain;
  }

  .moment-card .moment-media[data-ig-frame='reel'] img {
    object-fit: cover;
  }

  .moment-card .moment-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: var(--ig-fit, cover);
    object-position: center center;
  }

  @media (min-width: 1080px) {
    .moments-section .moments-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .moments-section--archive {
    background: #eee9dd;
  }
</style>
