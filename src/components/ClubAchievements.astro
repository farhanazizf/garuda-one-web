---
import {
  achievementsGridMedia,
  homeAchievementsMedia,
  instagramThumbDimensions,
  instagramThumbFit,
} from '../data/club-media';
import type { Locale } from '../i18n/locales';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { getMessages } from '../i18n/messages';
import { localePagePath } from '../i18n/paths';
import { withBase } from '../utils/paths';

interface Props {
  locale?: Locale;
  variant?: 'highlight' | 'archive';
}

const { locale = DEFAULT_LOCALE, variant = 'highlight' } = Astro.props;
const t = getMessages(locale).achievements;
const shared = getMessages(locale).shared;

function fmt(template: string, vars: Record<string, string | number>) {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? `{${key}}`));
}

const isArchive = variant === 'archive';
const all = achievementsGridMedia();
const items = isArchive ? all : homeAchievementsMedia();
const total = all.length;
---

<section
  class:list={['achievements-section', 'section-pad', isArchive && 'achievements-section--archive']}
  aria-labelledby={isArchive ? 'achievements-archive-title' : 'achievements-title'}
  id={isArchive ? 'prestasi-klub' : undefined}
>
  <div class="achievements-heading">
    <span class="section-number">{t.label}</span>
    {
      isArchive ? (
        <h2 id="achievements-archive-title">
          {t.archiveTitle.before}<br /><em>{t.archiveTitle.emphasis}</em>
        </h2>
      ) : (
        <h2 id="achievements-title">
          {t.highlightTitle.before}<br /><em>{t.highlightTitle.emphasis}</em>
        </h2>
      )
    }
    {
      isArchive ? (
        <p class="achievements-intro">{fmt(t.archiveIntro, { total })}</p>
      ) : (
        <p class="achievements-intro">{t.highlightIntro}</p>
      )
    }
    {
      !isArchive && total > items.length ? (
        <a class="achievements-more inline-link" href={`${localePagePath(locale, 'about')}#prestasi-klub`}>
          {t.moreLink} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
        </a>
      ) : null
    }
  </div>
  <div class="achievements-grid">
    {
      items.map((item, index) => {
        const thumb = instagramThumbDimensions(item);
        const fit = instagramThumbFit(item);
        const isEnglish = locale === 'en';
        const kicker = isEnglish ? item.kickerEn ?? item.kicker : item.kicker;
        const title = isEnglish ? item.titleEn ?? item.title : item.title;
        const caption = isEnglish ? item.captionEn ?? item.caption : item.caption;
        const alt = isEnglish ? item.altEn ?? item.alt ?? title : item.alt ?? title;
        const sourceDate = isEnglish ? item.sourceDateEn ?? item.sourceDate : item.sourceDate;
        return (
        <article class="achievement-card">
          <span class="achievement-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="achievement-media-slot">
            {item.localReady && item.localPath ? (
              <a
                class="achievement-media"
                style={`--ig-fit: ${fit}`}
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={withBase(item.localPath.replace(/^\//, ''))}
                  alt={alt}
                  width={thumb.width}
                  height={thumb.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <div class="achievement-media" aria-hidden="true" />
            )}
          </div>
          <div class="achievement-body">
            {kicker ? <p class="achievement-kicker">{kicker}</p> : null}
            <h3>{title}</h3>
            {caption ? <p class="achievement-caption">{caption}</p> : null}
            {sourceDate ? <p class="achievement-date">{sourceDate}</p> : null}
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {shared.openPost} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
              </a>
            ) : null}
          </div>
        </article>
      );
      })
    }
  </div>
</section>

<style>
  .achievements-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    background: #181715;
    color: #f3f0e8;
  }

  .achievements-heading h2 {
    font-family: 'Barlow Condensed', Impact, sans-serif;
    font-size: clamp(3.4rem, 5.5vw, 5.8rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 2rem 0 1.2rem;
  }

  .achievements-heading h2 em {
    font-style: normal;
    color: #d5ad69;
  }

  .achievements-intro {
    max-width: 520px;
    color: #c9c4bd;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .achievements-more {
    display: inline-block;
    margin-top: 0.35rem;
    color: #e4b96e;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 1px;
    background: #3a3630;
    border: 1px solid #3a3630;
  }

  .achievement-card {
    background: #22201c;
    padding: 1.6rem 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 220px;
  }

  .achievement-index {
    font-family: 'Barlow Condensed', Impact, sans-serif;
    font-size: 1.6rem;
    color: #d5ad69;
    line-height: 1;
  }

  .achievement-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 10.5rem;
  }

  .achievement-kicker {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #a47d4a;
    margin: 0;
  }

  .achievement-body h3 {
    font-family: 'Barlow Condensed', Impact, sans-serif;
    text-transform: uppercase;
    font-size: 1.65rem;
    line-height: 1.05;
    margin: 0 0 0.5rem;
    color: #f3f0e8;
  }

  .achievement-caption,
  .achievement-date {
    font-size: 0.9rem;
    color: #a8a39c;
    line-height: 1.55;
    margin: 0 0 0.35rem;
  }

  .achievement-body > a {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
    margin-top: auto;
    align-self: flex-start;
    color: #e4b96e;
  }

  .achievement-media-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
  }

  .achievement-card .achievement-media {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border: 1px solid #3a3630;
    background: #141210;
  }

  .achievement-card .achievement-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: var(--ig-fit, contain);
    object-position: center center;
  }

  @media (min-width: 1080px) {
    .achievements-section .achievements-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .achievements-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }

  .achievements-section--archive {
    background: #0c0c0b;
  }
</style>
