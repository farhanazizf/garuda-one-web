---
import BaseLayout from '../layouts/BaseLayout.astro';
import MotionDirector from '../components/MotionDirector.jsx';
import ClubAchievements from '../components/ClubAchievements.astro';
import ClubMoments from '../components/ClubMoments.astro';
import InstagramActivity from '../components/InstagramActivity.astro';
import { club, clubMapsLinkProps, registrationLink } from '../data/club';
import type { Locale } from '../i18n/locales';
import { getMessages } from '../i18n/messages';
import { localePagePath } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = getMessages(locale).home;
const shared = getMessages(locale).shared;
const regLink = registrationLink(locale);
const heroCaptionLines = m.heroMarkCaption.split('\n');

function fmt(template: string, vars: Record<string, string | number>) {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? `{${key}}`));
}
---

<BaseLayout locale={locale} page="home" title={m.metaTitle} description={m.metaDescription}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> {m.heroEyebrow}</p>
      <h1 id="hero-title" class="max-w-6xl">{m.heroTitle.before}<br /><em>{m.heroTitle.emphasis}</em></h1>
      <p class="hero-intro">{m.heroIntro}</p>
      <div class="hero-actions">
        <a class="button button-gold" href={regLink} target="_blank" rel="noopener noreferrer">
          {m.heroCtaRegister} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
        </a>
        <a class="text-link" href={localePagePath(locale, 'about')}>
          {m.heroCtaAbout} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
        </a>
      </div>
    </div>
    <div class="hero-mark" aria-label={m.heroLogoAlt}>
      <img src={club.logo} alt={m.heroLogoAlt} width="512" height="512" fetchpriority="high" />
      <span class="hero-mark-caption">{heroCaptionLines[0]}<br />{heroCaptionLines[1]}</span>
    </div>
    <div class="hero-bottom"><span>{m.heroBottomLeft}</span><span>{m.heroBottomRight}</span></div>
  </section>

  <div class="club-marquee" aria-hidden="true">
    <div class="club-marquee-track">
      {m.marquee.map((line) => (
        <span>{line}</span>
      ))}
    </div>
  </div>

  <section class="intro-section section-pad" aria-labelledby="intro-title">
    <div class="section-heading">
      <span class="section-number">{m.introLabel}</span>
      <h2 id="intro-title">{m.introTitle.before}<br />{m.introTitle.emphasis}</h2>
    </div>
    <div class="intro-content">
      <p>{m.introLead}</p>
      <p class="intro-source">
        {m.introSourceBeforeAges}<strong>{shared.ages}</strong>{m.introSourceAfterAges}
        <a {...clubMapsLinkProps}>{club.venueName}</a>{m.introSourceVenueSuffix}
      </p>
      <a class="inline-link" href={localePagePath(locale, 'about')}>
        {m.introLink} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
      </a>
    </div>
  </section>

  <ClubAchievements locale={locale} />
  <ClubMoments locale={locale} />

  <section class="path-section section-pad" aria-labelledby="path-title">
    <div class="section-topline">
      <span class="section-number">{m.pathLabel}</span><span>{m.pathAside}</span>
    </div>
    <h2 id="path-title">{m.pathTitle.before}<br /><em>{m.pathTitle.emphasis}</em></h2>
    <div class="path-grid">
      {m.pathSteps.map((step) => (
        <article class="path-item">
          <span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p>
        </article>
      ))}
    </div>
    <a class="button button-dark" href={regLink} target="_blank" rel="noopener noreferrer">
      {m.pathCta} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
    </a>
  </section>

  <section class="faq-section section-pad" aria-labelledby="faq-title">
    <div>
      <p class="section-number">{m.faqLabel}</p>
      <h2 id="faq-title">{m.faqTitle.before}<br />{m.faqTitle.emphasis}</h2>
    </div>
    <div class="faq-list">
      {m.faqItems.map((item, index) => (
        <details open={index === 0}>
          <summary>
            {item.question}
            <span class="faq-preview">{index === 1 ? fmt(item.preview, { venue: club.venueName }) : item.preview}</span>
          </summary>
          {index === 1 ? (
            (() => {
              const parts = fmt(item.answer, { venue: club.venueName }).split('. ');
              const lead = parts.shift() ?? '';
              const tail = parts.join('. ');
              return (
                <p>
                  {lead}.{tail ? ' ' : ''}
                  <a {...clubMapsLinkProps}>{m.faqMapsLinkText} {shared.mapsLinkSuffix}</a>.
                  {tail ? ` ${tail}` : null}
                </p>
              );
            })()
          ) : (
            <p>{item.answer}</p>
          )}
        </details>
      ))}
    </div>
  </section>

  <InstagramActivity locale={locale} />

  <section class="sponsor-teaser section-pad" aria-labelledby="partnership-title">
    <div>
      <p class="section-number">{m.partnershipTeaserLabel}</p>
      <h2 id="partnership-title">{m.partnershipTeaserTitle.before}<br /><em>{m.partnershipTeaserTitle.emphasis}</em></h2>
    </div>
    <div>
      <p>{m.partnershipTeaserBody}</p>
      <a class="button button-outline" href={localePagePath(locale, 'partnership')}>
        {m.partnershipTeaserCta} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
      </a>
    </div>
  </section>
  <section class="contact-band section-pad home-contact" aria-labelledby="contact-title">
    <span class="section-number">{m.contactLabel}</span>
    <h2 id="contact-title">{m.contactTitle.before}<br /><em>{m.contactTitle.emphasis}</em></h2>
    <a class="button button-gold" href={regLink} target="_blank" rel="noopener noreferrer">
      {m.contactCta} <span aria-hidden="true">{shared.mapsLinkSuffix}</span>
    </a>
  </section>
  <MotionDirector client:load />
</BaseLayout>
